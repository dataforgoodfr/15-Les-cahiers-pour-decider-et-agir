# ==============================================================================
# Configuration de la plateforme (12-Factor App)
# Copiez ce fichier vers `.env` en local : cp .env.example .env
# ==============================================================================

# Environnement de déploiement : LOCAL, STAGING ou PROD
DJANGO_ENV=LOCAL

# Mode debug (1 en LOCAL, 0 en STAGING et PROD)
DJANGO_DEBUG=1

# Clé secrète Django (optionnelle en LOCAL, obligatoire en STAGING et PROD)
# Générer une clé avec : uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-developpement-local

# Domaines autorisés séparés par des virgules (localhost et 127.0.0.1 sont ajoutés automatiquement en LOCAL)
# Ex. STAGING : DJANGO_ALLOWED_HOSTS=cahiers-staging.cleverapps.io
# Ex. PROD    : DJANGO_ALLOWED_HOSTS=cahiers.cleverapps.io,cahiers.decider-agir.fr
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
# En LOCAL (conteneur Docker pg-cahiers) :
DATABASE_URL=postgres://postgres:cahiers@localhost:5432/cahiers
# En STAGING / PROD sur Clever Cloud, POSTGRESQL_ADDON_URI est injectée automatiquement par l'add-on.

# Stockage S3 / Cellar (optionnel en LOCAL : utilise le disque local `media/` si non défini)
# En STAGING / PROD sur Clever Cloud, CELLAR_ADDON_* sont injectées par l'add-on :
# CELLAR_ADDON_HOST=
# CELLAR_ADDON_KEY_ID=
# CELLAR_ADDON_KEY_SECRET=
# CELLAR_BUCKET=
